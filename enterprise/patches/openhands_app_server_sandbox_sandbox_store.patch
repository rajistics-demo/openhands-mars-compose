+async def get_pending_create_intents(
+    db_session: AsyncSession, backend: str, older_than: datetime
+) -> list[StoredSandbox]:
+    """Rows of ``backend`` whose provider create is unresolved past a bound.
+
+    Scoped strictly to one backend with both columns non-default, so it never
+    touches another provider's rows, nor a do-mars row created before these
+    columns existed (which has no intent timestamp to match on). Used only by
+    the do-mars reconciliation path (D4); not a generic lifecycle hook.
+    """
+    stmt = select(StoredSandbox).where(
+        StoredSandbox.backend == backend,
+        StoredSandbox.provider_create_intent_at.is_not(None),
+        StoredSandbox.provider_create_intent_at < older_than,
+        StoredSandbox.provider_resource_id.is_(None),
+    )
+    result = await db_session.execute(stmt)
+    return list(result.scalars().all())
+
