# MARS evaluation overlay settings. Copy to mars.env outside any git checkout,
# fill in, and pass with `docker compose --env-file mars.env`.
# Placeholders only. Secrets are NOT set here: they are files under
# MARS_SECRETS_DIR (see docs/INSTALL.md, "Secrets").

# Images you built from docker/*.Dockerfile (tag them; record their digests).
MARS_APP_IMAGE=registry.example.invalid/openhands-enterprise-mars:1.88.0-mars2
MARS_AUTOMATION_IMAGE=registry.example.invalid/openhands-automation-mars:1.30.0-mars2

# Operator-created DigitalOcean MARS (Harness Runtime) environment config. The
# tested contract is the builtin `openhands` harness (Agent Server 1.58.2);
# a custom harness/image digest is rejected on Private Beta (docs/VERSIONS.md).
# The config also holds the egress allowlist. Register a new config per
# release; do not edit one in place.
DO_MARS_CONFIG_ID=00000000-0000-4000-8000-000000000000

# Public HTTPS runtime origin served by mars-gateway through your TLS
# terminator. Separate hostname from the app origin.
DO_MARS_GATEWAY_URL=https://runtime.example.invalid
# Public HTTPS Enterprise origin that MARS guests call back to (must be in the
# MARS config egress allowlist).
DO_MARS_CALLBACK_URL=https://app.example.invalid
# Enterprise app origin allowed by the gateway's CORS policy.
DO_MARS_APP_ORIGIN=https://app.example.invalid
# Optional private path from app/worker to the gateway on the Compose network.
DO_MARS_INTERNAL_URL=http://mars-gateway:8100
MARS_GATEWAY_HOST_PORT=8100

# Per-sandbox session JWT lifetime (seconds). Default 8 h, clamped to 300..86400.
# An expired key needs a fresh sandbox; seamless rotation is not qualified.
DO_MARS_SESSION_TTL_SECONDS=28800

# Directory holding do_team_token, session_signing_key, init_api_key
# (readable by uid 42420 for mars-gateway; not world-readable).
MARS_SECRETS_DIR=/etc/openhands-mars/secrets

# Least-privilege gateway DB role (recommended; see docs/INSTALL.md).
MARS_GATEWAY_DB_USER=openhands_mars_gateway
MARS_GATEWAY_DB_PASS=change-me-not-a-real-password

# Automation: guest-facing Enterprise API origin and per-run key lifetime.
AUTOMATION_SANDBOX_OPENHANDS_API_URL=https://app.example.invalid
AUTOMATION_RUN_KEY_TTL_SECONDS=3600

# Enterprise idle pause for MARS sandboxes (seconds).
OH_SANDBOX_LIFECYCLE_IDLE_SECONDS=1800

# Per-identity admission cap (exceeding it can pause the oldest sandbox).
MARS_MAX_SANDBOXES=10

# Optional live Canvas previews on separate per-sandbox HTTPS hosts.
DO_MARS_ENABLE_BROWSER_PREVIEW=false

# Opt-in warm-pool of pre-created MARS sandboxes (hot + paused reserve).
# Disabled by default; everything below is inert while this is false.
#
# Preferred: set these same keys in site.env instead of here and use the
# standard `mars_setup.py check --stage mars` / `up --mars` flow - it
# validates them, layers the `pool` Compose profile for you, and asserts
# in `check` that they actually reached app/worker/mars-pool-reconciler.
# This file (a separate, manually-loaded --env-file) remains supported for
# operators who do not want the pool tracked by site.env/check; on that
# route you start the reconciler yourself:
# `docker compose ... --profile pool up -d`.
# See docs/INSTALL.md "Warm pool" and do_mars_pool_config.py for every
# setting and its validation rules.
#
# There is deliberately no separate "pool config id" setting: every pool
# slot is created under, and can only ever be claimed under, the same
# DO_MARS_CONFIG_ID set above (do_mars_pool_worker.py reads it directly,
# and do_mars_sandbox_service.py's claim query is keyed on the resolved
# spec's config_id), so a slot is never silently handed to a request
# expecting the new config after a rotation.
#
# Rotating DO_MARS_CONFIG_ID does NOT auto-reap the old config's slots:
# every reconciler step, including the unhealthy/stale-age sweep, is
# scoped to one (backend, sandbox_spec_id, config_id) triple
# (do_mars_pool_reconciler.py), so a reconciler running under the new
# config_id never even queries the old one's slots - they become
# orphaned, still-paying VMs, not reaped. Drain the OLD config first:
# set MIN_HOT=0, MIN_PAUSED_RESERVE=0 and MAX_TOTAL=0 while
# DO_MARS_CONFIG_ID still has its old value and leave the reconciler
# running until its normal over-max_total step deletes the old config's
# unclaimed inventory (never a slot a conversation already claimed) -
# then rotate DO_MARS_CONFIG_ID. See docs/INSTALL.md "Warm pool" for the
# full procedure, including that disabling the pool (DO_MARS_POOL_ENABLED
# or --profile pool) does not stop an already-running reconciler
# container by itself - stop it explicitly.
DO_MARS_POOL_ENABLED=false
# Required when enabled: the one Enterprise sandbox spec/DO config pool
# inventory is scoped to (never shared across specs - see
# DoMarsPoolConfig.sandbox_spec_id).
DO_MARS_POOL_SANDBOX_SPEC_ID=
DO_MARS_POOL_MIN_HOT=0
DO_MARS_POOL_MIN_PAUSED_RESERVE=0
# Must be >= DO_MARS_POOL_MIN_HOT + DO_MARS_POOL_MIN_PAUSED_RESERVE.
DO_MARS_POOL_MAX_TOTAL=0
DO_MARS_POOL_RECONCILE_INTERVAL_SECONDS=30

# Bring-your-own managed PostgreSQL for the pool reconciler (mars-pool-
# reconciler service, "pool" profile): this process is new (added by this
# overlay, not part of the stock Enterprise compose file) and connects to
# Postgres directly with its own DB_* env vars, independent of however the
# base app/worker services are wired to their database. If your Enterprise
# database is NOT the bundled `db` Compose service - e.g. a managed DO/RDS
# Postgres under the existing Enterprise DB contract - you must override
# these to point at it; the defaults below only work for the bundled `db`
# service. DB_USER/DB_PASS default to the same values the gateway uses.
# See do_mars_pool_config.py's module docstring: the connection must be
# session-pinned (a direct connection, or a pooler in "session" pool mode,
# never "transaction"/"statement" mode), or the pool's claim/advisory-lock
# safety guarantees silently stop holding.
DB_HOST=db
DB_PORT=5432
