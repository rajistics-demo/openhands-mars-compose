diff --git a/src/components/features/conversation/pilot-recovered-preview.tsx b/src/components/features/conversation/pilot-recovered-preview.tsx
new file mode 100644
index 000000000..aa4c7c98a
--- /dev/null
+++ b/src/components/features/conversation/pilot-recovered-preview.tsx
@@ -0,0 +1,144 @@
+import { useEffect, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import type { ResolvedActiveBackend } from "#/api/backend-registry/types";
+import { batchGetCloudSandboxes } from "#/api/cloud/sandbox-service.api";
+import type { AppConversation } from "#/api/conversation-service/agent-server-conversation-service.types";
+
+const PREVIEW_SESSION_PATH = "/.well-known/openhands-preview-session";
+const PREVIEW_RENEW_MS = 4 * 60 * 1000;
+
+function previewTarget(
+  url: string,
+  appOrigin: string,
+  sandboxId: string,
+  allowPilot: boolean,
+) {
+  let src: URL;
+  try {
+    src = new URL(url);
+  } catch {
+    return null;
+  }
+  if (src.search || src.hash || src.username || src.password) return null;
+
+  const app = new URL(appOrigin);
+  if (
+    app.protocol === "https:" &&
+    /^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$/.test(sandboxId) &&
+    src.origin === `https://${sandboxId}.preview.${app.hostname}` &&
+    src.pathname === "/"
+  ) {
+    return { href: src.href, credentialed: true };
+  }
+
+  if (!allowPilot) return null;
+  const aws =
+    src.origin === `https://runtime-repo.${app.host}` &&
+    src.pathname.replace(/\/$/, "") === `/${sandboxId}/8011`;
+  const e2b =
+    /^[a-z0-9]+$/.test(sandboxId) &&
+    src.origin === `https://8011-${sandboxId}.e2b.app` &&
+    src.pathname === "/";
+  if (!aws && !e2b) return null;
+  if (!src.pathname.endsWith("/")) src.pathname += "/";
+  return { href: src.href, credentialed: false };
+}
+
+function usePreviewSession(
+  origin: string | undefined,
+  key: string | undefined,
+) {
+  const [authorizedOrigin, setAuthorizedOrigin] = useState<string>();
+  useEffect(() => {
+    setAuthorizedOrigin(undefined);
+    if (!origin || !key) return undefined;
+
+    const controller = new AbortController();
+    const authorize = async () => {
+      try {
+        const response = await fetch(new URL(PREVIEW_SESSION_PATH, origin), {
+          method: "POST",
+          headers: { "X-Session-API-Key": key },
+          credentials: "include",
+          redirect: "error",
+          signal: controller.signal,
+        });
+        if (!controller.signal.aborted) {
+          setAuthorizedOrigin(response.status === 204 ? origin : undefined);
+        }
+      } catch {
+        if (!controller.signal.aborted) setAuthorizedOrigin(undefined);
+      }
+    };
+
+    void authorize();
+    const renewal = window.setInterval(authorize, PREVIEW_RENEW_MS);
+    return () => {
+      controller.abort();
+      window.clearInterval(renewal);
+    };
+  }, [origin, key]);
+
+  return !!key && authorizedOrigin === origin;
+}
+
+export function PilotRecoveredPreview({
+  conversation,
+  active,
+}: {
+  conversation:
+    | Pick<
+        AppConversation,
+        "sandbox_id" | "sandbox_status" | "tags" | "session_api_key"
+      >
+    | null
+    | undefined;
+  active: ResolvedActiveBackend;
+}) {
+  const appOrigin =
+    typeof window === "undefined" ? undefined : window.location.origin;
+  const sandboxId = conversation?.sandbox_id;
+  const enabled =
+    !!appOrigin &&
+    active.backend.kind === "cloud" &&
+    active.backend.host === appOrigin &&
+    conversation?.sandbox_status === "RUNNING" &&
+    !!sandboxId;
+  const allowPilot =
+    import.meta.env.VITE_CANVAS_RECOVERY_PILOT_ORIGIN === appOrigin &&
+    conversation?.tags?.canvasrecoverypilotpreview === "true";
+  const sandbox = useQuery({
+    queryKey: [
+      "canvas-workspace-preview",
+      active.backend.id,
+      active.orgId,
+      sandboxId,
+    ],
+    enabled,
+    queryFn: async () => (await batchGetCloudSandboxes([sandboxId!]))[0],
+  });
+  const preview = sandbox.data?.exposed_urls?.find(
+    ({ name }) => name === "WORKER_1",
+  );
+  const target =
+    enabled && preview && sandbox.data?.id === sandboxId
+      ? previewTarget(preview.url, appOrigin, sandboxId, allowPilot)
+      : null;
+  const authorized = usePreviewSession(
+    target?.credentialed ? target.href : undefined,
+    conversation?.session_api_key ?? undefined,
+  );
+
+  if (!target || (target.credentialed && !authorized)) return null;
+  return (
+    <iframe
+      // eslint-disable-next-line i18next/no-literal-string -- short a11y label for an internal pilot preview frame, not yet wired to i18n
+      title="Live workspace preview"
+      data-testid="canvas-pilot-live-preview"
+      src={target.href}
+      referrerPolicy="no-referrer"
+      sandbox="allow-scripts allow-same-origin"
+      className="h-64 w-full shrink-0 border-t"
+    />
+  );
+}
